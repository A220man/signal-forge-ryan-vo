# Signal Forge Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=Signal Forge
APP_VERSION=1.0.0
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Geocoding (Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=signal-forge/1.0
NOMINATIM_RATE_LIMIT=1.0
GEOCODE_CACHE_TTL=3600

# Demo mode (local development only - binds to localhost)
DEMO_MODE=true

# LLM Providers (for future voice/agent features)
# Only LLM_API_KEY is a secret; others are optional non-secret settings
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# OpenAI-compatible (OpenAI, LiteLLM, OpenRouter, Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Keycloak (for future auth)
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=signal-forge
# KEYCLOAK_CLIENT_ID=signal-forge-frontend
# KEYCLOAK_CLIENT_SECRET=